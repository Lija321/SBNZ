template header
caseType
partyType
documentType
required
taskIfMissing

package rules;

import com.sbnz.legal.domain.CaseClassification;
import com.sbnz.legal.domain.Document;
import com.sbnz.legal.domain.Party;
import com.sbnz.legal.domain.MissingRequiredDocument;
import com.sbnz.legal.domain.MissingExpectedDocument;
import com.sbnz.legal.domain.SuggestedTask;
import com.sbnz.legal.domain.enums.CaseType;
import com.sbnz.legal.domain.enums.DocumentType;
import com.sbnz.legal.domain.enums.PartyType;
import com.sbnz.legal.domain.enums.TaskType;

dialect "java"

template "document-checklist"

rule "@{caseType}_missing_@{documentType}_@{row.rowNumber}"
salience 40
when
    $cc : CaseClassification($id : caseId, caseType == CaseType.@{caseType})
@if{partyType != "ANY"}
    Party(caseId == $id, partyType == PartyType.@{partyType})
@end{}
    not Document(caseId == $id, documentType == DocumentType.@{documentType}, present == true)
@if{required == "TRUE"}
    not MissingRequiredDocument(caseId == $id, documentType == DocumentType.@{documentType})
@else{}
    not MissingExpectedDocument(caseId == $id, documentType == DocumentType.@{documentType})
@end{}
    not SuggestedTask(caseId == $id, taskType == TaskType.@{taskIfMissing}, open == true)
then
@if{required == "TRUE"}
    insert(new MissingRequiredDocument($id, DocumentType.@{documentType}));
@else{}
    insert(new MissingExpectedDocument($id, DocumentType.@{documentType}));
@end{}
    insert(new SuggestedTask($id, TaskType.@{taskIfMissing}));
end

end template
